# MedAssist AI Environment Variables Template
# Copy this file to .env and fill in the values

# Groq AI API Key (Required for Diagnosis)
# Get it from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Client ID (Required for Google Login)
# Get it from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Secret Key (Required for local authentication)
# Generate a secure one using: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here
